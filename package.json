{
  "name": "ledgerly",
  "version": "0.1.0",
  "private": true,
  "description": "Confidential, audit-ready merchant payments & remittance on NEAR",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:backup": "node scripts/db-backup.mjs",
    "seed": "tsx scripts/seed.ts",
    "seed:reset": "tsx scripts/seed.ts --reset",
    "contract:test": "cargo test --manifest-path contracts/ledgerly-escrow/Cargo.toml --lib",
    "contract:check": "cargo check --manifest-path contracts/ledgerly-escrow/Cargo.toml --target wasm32-unknown-unknown",
    "contract:build": "RUSTFLAGS='-C target-feature=-reference-types,-multivalue -C link-arg=-s' cargo build --manifest-path contracts/ledgerly-escrow/Cargo.toml --target wasm32-unknown-unknown --release",
    "usdc:build": "RUSTFLAGS='-C target-feature=-reference-types,-multivalue -C link-arg=-s' cargo build --manifest-path contracts/mock-usdc/Cargo.toml --target wasm32-unknown-unknown --release",
    "usdc:deploy": "npm run usdc:build && tsx scripts/deploy-usdc.ts",
    "contract:deploy": "npm run contract:build && tsx scripts/deploy-testnet.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "framer-motion": "14.10.1",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.187.0"
  }
}
