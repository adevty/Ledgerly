# ============================================================================
# Ledgerly — NEAR Testnet Configuration
# ============================================================================
# Copy this file to `.env.local` and fill in `NEAR_OPERATOR_ACCOUNT_ID` and
# `NEAR_OPERATOR_PRIVATE_KEY` to switch `/app` from Local Sandbox mode to
# Live NEAR Testnet RPC mode (`NearRpcChainGateway`).

NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_EXPLORER_BASE_URL=https://testnet.nearblocks.io

# Target `ledgerly-escrow` smart contract account on NEAR Testnet
NEAR_ESCROW_CONTRACT_ID=escrow.ledgerly.testnet

# NEP-141 USDC token contract on NEAR Testnet
NEAR_USDC_CONTRACT_ID=usdc.fakes.testnet

# Operator NEAR Testnet account & Ed25519 secret key (`ed25519:...`)
# Leave blank to run in deterministic Local Sandbox Simulation mode
NEAR_OPERATOR_ACCOUNT_ID=
NEAR_OPERATOR_PRIVATE_KEY=

# NEAR Intents 1Click: set to true to enable real cross-chain deposit addresses (default: false for safe dry-run quotes)
ENABLE_LIVE_INTENTS=false
